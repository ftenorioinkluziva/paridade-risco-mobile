{
  "name": "paridade-risco-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync:ide": "node .aiox-core/infrastructure/scripts/ide-sync/index.js sync",
    "sync:ide:check": "node .aiox-core/infrastructure/scripts/ide-sync/index.js validate --strict",
    "sync:skills:codex": "node .aiox-core/infrastructure/scripts/codex-skills-sync/index.js",
    "sync:skills:codex:global": "node .aiox-core/infrastructure/scripts/codex-skills-sync/index.js --global",
    "validate:structure": "node .aiox-core/infrastructure/scripts/validate-paths.js",
    "validate:agents": "node .aiox-core/infrastructure/scripts/validate-agents.js",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace @paridade-risco/api",
    "build:api": "npm run build --workspace @paridade-risco/api",
    "lint:api": "npm run lint --workspace @paridade-risco/api",
    "typecheck:api": "npm run typecheck --workspace @paridade-risco/api",
    "db:generate": "npm run db:generate --workspace @paridade-risco/api",
    "db:migrate": "npm run db:migrate --workspace @paridade-risco/api",
    "db:studio": "npm run db:studio --workspace @paridade-risco/api",
    "dev:cli": "node packages/cli/src/index.mjs",
    "dev:mcp": "node packages/local-mcp/src/index.mjs",
    "dev:remote-mcp": "node apps/remote-mcp/src/index.mjs"
  },
  "devDependencies": {}
}